---
import '../styles/global.css';
import { site } from '../site.config';

interface Props {
  title?: string;
  section: 'home' | 'photography' | 'media-art' | 'graphic-design';
}
const { title, section } = Astro.props;
const base = import.meta.env.BASE_URL;
const nav = [
  { id: 'photography', label: 'Photography', href: `${base}photo/` },
  { id: 'media-art', label: 'Media Art', href: `${base}media-art/` },
  { id: 'graphic-design', label: 'Graphic Design', href: `${base}graphic-design/` },
] as const;
---

<!doctype html>
<html lang="en" data-theme="light" data-view="album">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} — ${site.name}` : site.name}</title>
    <meta name="description" content={site.description} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <script is:inline>
      document.documentElement.classList.add('js');
      try {
        var v = new URLSearchParams(location.search).get('view') || localStorage.getItem('view');
        if (v === 'single') v = 'gallery';
        if (v === 'album' || v === 'grid' || v === 'gallery') document.documentElement.dataset.view = v;
      } catch (e) {}
    </script>
  </head>
  <body>
    <header class="top">
      <div class="top-left">
        <a href={base} class="mark" aria-current={section === 'home' ? 'page' : undefined}>Hi, I'm {site.name}</a>
        <nav class="sections" aria-label="Sections">
          {nav.map((n) => <a href={n.href} aria-current={n.id === section ? 'page' : undefined}>{n.label}</a>)}
        </nav>
      </div>
      <div class="top-right">
        <slot name="tools" />
        <button type="button" class="menu-btn" data-menu-open>Menu</button>
      </div>
    </header>

    <slot />

    <!-- 手机菜单 -->
    <div class="sheet" data-sheet hidden>
      <button type="button" class="sheet-close" data-menu-close>Close</button>
      <nav class="sheet-sections">
        {nav.map((n) => <a href={n.href} aria-current={n.id === section ? 'page' : undefined}>{n.label}</a>)}
      </nav>
      <slot name="sheet" />
    </div>

    <script>
      const html = document.documentElement;
      const sheet = document.querySelector<HTMLElement>('[data-sheet]')!;
      const close = () => { sheet.hidden = true; html.classList.remove('lock'); };
      document.querySelector('[data-menu-open]')!.addEventListener('click', () => { sheet.hidden = false; html.classList.add('lock'); });
      document.querySelector('[data-menu-close]')!.addEventListener('click', close);
      sheet.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a, [data-close-sheet]')) close(); });
      addEventListener('keydown', (e) => { if (e.key === 'Escape' && !sheet.hidden) close(); });
    </script>
  </body>
</html>

<style>
  .top {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 40;
    height: var(--header);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 var(--gutter);
    background: var(--bg);
    transition: background-color 0.9s var(--ease);
  }
  .top-left { display: flex; align-items: center; }
  .mark {
    font-weight: 600;
    letter-spacing: 0.01em;
    width: calc(var(--rail) - var(--gutter));
  }
  .sections { display: flex; gap: 22px; }
  .sections a,
  .sheet-sections a {
    color: var(--muted);
    transition: color 0.3s;
  }
  .sections a:hover,
  .sections a[aria-current='page'],
  .sheet-sections a[aria-current='page'] { color: var(--fg); }
  .top-right { display: flex; align-items: center; gap: 24px; }
  .menu-btn { display: none; }

  @media (max-width: 899px) {
    .mark { width: auto; }
    .sections { display: none; }
    .menu-btn { display: block; }
  }

  .sheet {
    position: fixed;
    inset: 0;
    z-index: 60;
    background: var(--bg);
    padding: calc(var(--header) + 4vh) var(--gutter) 32px;
    display: flex;
    flex-direction: column;
    overflow-y: auto;
  }
  .sheet[hidden] { display: none; }
  .sheet-close { position: absolute; top: 0; right: var(--gutter); height: var(--header); }
  .sheet-sections {
    display: grid;
    gap: 10px;
    margin-bottom: 40px;
    font-size: 26px;
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  :global(html.lock) { overflow: hidden; }
</style>
