---
import '../styles/global.css';
import { site } from '../site.config';

interface Props {
  title?: string;
  section: 'home' | 'photo' | 'media' | 'graphic' | 'none';
}
const { title, section } = Astro.props;
const base = import.meta.env.BASE_URL;
const nav = [
  { id: 'photo', label: 'Photo', href: `${base}photo/` },
  { id: 'media', label: 'Media', href: `${base}media/` },
  { id: 'graphic', label: 'Graphic', href: `${base}graphic/` },
] as const;
---

<!doctype html>
<html lang="en" data-theme={site.theme} data-view="album">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} — ${site.name}` : site.name}</title>
    <meta name="description" content={site.description} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <script is:inline>
      document.documentElement.classList.add('js');
      // 深色 / 浅色：沿用访客上次的选择
      try {
        var t = localStorage.getItem('theme');
        if (t === 'dark' || t === 'light') document.documentElement.dataset.theme = t;
      } catch (e) {}
      try {
        var v = new URLSearchParams(location.search).get('view') || localStorage.getItem('view');
        if (v === 'single') v = 'gallery';
        if (v === 'album' || v === 'grid' || v === 'gallery') document.documentElement.dataset.view = v;
      } catch (e) {}
    </script>
  </head>
  <body>
    <header class="top">
      <div class="top-left">
        <a href={base} class="mark" aria-current={section === 'home' ? 'page' : undefined}>Hi, I'm {site.name}</a>
        <nav class="sections" aria-label="Sections">
          {nav.map((n) => <a href={n.href} aria-current={n.id === section ? 'page' : undefined}>{n.label}</a>)}
        </nav>
      </div>
      <div class="top-right">
        <slot name="tools" />
        {site.email && (
          <a href={`mailto:${site.email}`} class="mail" aria-label={`Email ${site.email}`} title={site.email}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
              <rect x="3" y="5.5" width="18" height="13" rx="1.5" />
              <path d="M3.5 6.5 12 13l8.5-6.5" />
            </svg>
          </a>
        )}
        <!-- 深色 / 浅色切换：独立按钮，全站通用 -->
        <button type="button" class="icon-btn" data-theme-toggle aria-label="Switch theme">
          <svg width="13" height="13" viewBox="0 0 14 14" aria-hidden="true">
            <circle cx="7" cy="7" r="6" fill="none" stroke="currentColor" stroke-width="1.15" />
            <path d="M7 1a6 6 0 0 1 0 12z" fill="currentColor" />
          </svg>
        </button>
        <button type="button" class="menu-btn" data-menu-open>Menu</button>
      </div>
    </header>

    <slot />

    <!-- 手机菜单 -->
    <div class="sheet" data-sheet hidden>
      <button type="button" class="sheet-close" data-menu-close>Close</button>
      <nav class="sheet-sections">
        {nav.map((n) => <a href={n.href} aria-current={n.id === section ? 'page' : undefined}>{n.label}</a>)}
      </nav>
      <slot name="sheet" />
    </div>

    <script>
      const html = document.documentElement;

      // 深色 / 浅色切换：全站统一，记住访客的选择
      const themeBtn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]')!;
      const syncTheme = () => {
        const dark = html.dataset.theme === 'dark';
        themeBtn.setAttribute('aria-label', dark ? 'Switch to light mode' : 'Switch to dark mode');
        themeBtn.title = dark ? 'Light mode' : 'Dark mode';
      };
      themeBtn.addEventListener('click', () => {
        html.dataset.theme = html.dataset.theme === 'dark' ? 'light' : 'dark';
        try { localStorage.setItem('theme', html.dataset.theme); } catch {}
        syncTheme();
      });
      syncTheme();

      const sheet = document.querySelector<HTMLElement>('[data-sheet]')!;
      const close = () => { sheet.hidden = true; html.classList.remove('lock'); };
      document.querySelector('[data-menu-open]')!.addEventListener('click', () => { sheet.hidden = false; html.classList.add('lock'); });
      document.querySelector('[data-menu-close]')!.addEventListener('click', close);
      sheet.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a, [data-close-sheet]')) close(); });
      addEventListener('keydown', (e) => { if (e.key === 'Escape' && !sheet.hidden) close(); });
    </script>
  </body>
</html>

<style>
  .top {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 40;
    height: var(--header);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 var(--gutter);
    background: var(--bg);
    transition: background-color 0.9s var(--ease);
  }
  .top-left { display: flex; align-items: center; }
  /* 签名 logo：WindSong 花体，只用在这里 */
  .mark {
    font-family: 'WindSong', var(--sans);
    font-weight: 400;
    font-size: 23px;
    line-height: 1;
    white-space: nowrap;
    margin-right: 56px;
    padding-top: 4px; /* 花体的视觉重心偏上，往下压一点与导航对齐 */
  }
  .sections { display: flex; gap: 56px; }
  .sections a,
  .sheet-sections a {
    color: var(--muted);
    transition: color 0.3s;
  }
  .sections a:hover { color: var(--fg); }
  .sections a[aria-current='page'],
  .sheet-sections a[aria-current='page'] { color: var(--accent); }
  .top-right { display: flex; align-items: center; gap: 24px; }
  .mail {
    display: flex;
    color: var(--muted);
    transition: color 0.3s;
  }
  .mail:hover { color: var(--accent); }
  .icon-btn {
    display: flex;
    color: var(--muted);
    transition: color 0.3s;
  }
  .icon-btn:hover { color: var(--accent); }
  .icon-btn svg { transition: transform 0.6s var(--ease); }
  :global(html[data-theme='light']) .icon-btn svg { transform: rotate(180deg); }
  .menu-btn { display: none; }

  @media (max-width: 899px) {
    .mark { width: auto; }
    .sections { display: none; }
    .menu-btn { display: block; }
  }

  .sheet {
    position: fixed;
    inset: 0;
    z-index: 60;
    background: var(--bg);
    padding: calc(var(--header) + 4vh) var(--gutter) 32px;
    display: flex;
    flex-direction: column;
    overflow-y: auto;
  }
  .sheet[hidden] { display: none; }
  .sheet-close { position: absolute; top: 0; right: var(--gutter); height: var(--header); }
  .sheet-sections {
    display: grid;
    gap: 10px;
    margin-bottom: 40px;
    font-size: 26px;
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  :global(html.lock) { overflow: hidden; }
</style>
