---
import Photo from './Photo.astro';
import type { Series } from '../lib/photos';

interface Props { series: Series[] }
const { series } = Astro.props;
const base = import.meta.env.BASE_URL;
const pad = (n: number) => String(n).padStart(2, '0');

// 两栏错落：左栏宽、右栏窄且整体下沉。每栏内的项宽度 / 对齐 / 裁切比例循环使用
const styleA = [
  { w: 100, ml: 0, ar: '4 / 5' },
  { w: 76, ml: 24, ar: '1 / 1' },
  { w: 100, ml: 0, ar: '3 / 2' },
  { w: 82, ml: 6, ar: '4 / 5' },
];
const styleB = [
  { w: 100, ml: 0, ar: '3 / 4' },
  { w: 82, ml: 0, ar: '4 / 5' },
  { w: 100, ml: 0, ar: '1 / 1' },
];
const cols = [
  series.map((s, i) => ({ s, i })).filter(({ i }) => i % 2 === 0),
  series.map((s, i) => ({ s, i })).filter(({ i }) => i % 2 === 1),
];
---

<div class="sx">
  {cols.map((col, c) => (
    <div class={`sx-col sx-col-${c}`}>
      {col.map(({ s, i }, k) => {
        const st = (c === 0 ? styleA : styleB)[k % (c === 0 ? styleA : styleB).length];
        return (
          <a
            href={`${base}photography/${s.slug}/`}
            class="sx-item"
            style={`order:${i};--w:${st.w}%;--ml:${st.ml}%;--ar:${st.ar}`}
          >
            <div class="sx-img reveal">
              <Photo photo={s.cover} sizes={`(max-width: 640px) 86vw, ${c === 0 ? 50 : 32}vw`} />
            </div>
            <div class="sx-cap">
              <span class="label sx-num">{pad(i + 1)}</span>
              <span class="display sx-title">{s.title}</span>
              <span class="label sx-count">{s.count}</span>
            </div>
          </a>
        );
      })}
    </div>
  ))}
</div>

<style>
  .sx {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding: 0 var(--gutter);
  }
  .sx-col { display: flex; flex-direction: column; gap: clamp(72px, 11vw, 200px); }
  .sx-col-0 { width: 54%; }
  .sx-col-1 { width: 36%; padding-top: clamp(120px, 26vw, 460px); }

  .sx-item {
    display: block;
    width: var(--w);
    margin-left: var(--ml);
  }
  .sx-img :global(.ph) { aspect-ratio: var(--ar); }
  .sx-img :global(img) {
    transform: scale(1.001);
    transition: transform 1.6s var(--ease);
  }
  .sx-item:hover .sx-img :global(img) { transform: scale(1.04); }

  .sx-cap {
    display: flex;
    align-items: baseline;
    gap: 14px;
    padding-top: 14px;
  }
  .sx-num,
  .sx-count { color: var(--muted); }
  .sx-title {
    font-size: clamp(34px, 4.2vw, 72px);
    font-style: italic;
    transition: letter-spacing 0.8s var(--ease);
  }
  .sx-item:hover .sx-title { letter-spacing: 0.01em; }
  .sx-count { margin-left: auto; }

  /* 手机：单栏，按原顺序（order）交替左右 */
  @media (max-width: 640px) {
    .sx { flex-direction: column; gap: 72px; }
    .sx-col { display: contents; }
    .sx-item { width: 86%; margin-left: 0; }
    .sx-item:nth-child(n) { --ml: 0%; }
    .sx-col-1 .sx-item { margin-left: 14%; }
  }
</style>
