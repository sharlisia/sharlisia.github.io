---
interface Props { title: string; zh: string }
const { title, zh } = Astro.props;
---

<main class="cs">
  <h1>{title}</h1>
  <p class="muted">{zh}</p>
  <p class="muted note">In progress.</p>
</main>

<style>
  .cs {
    min-height: 100svh;
    padding: calc(var(--header) + 22vh) var(--gutter) 10vh calc(var(--rail) + var(--gutter));
  }
  h1 {
    margin: 0 0 10px;
    font-size: clamp(34px, 4.4vw, 64px);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1;
  }
  p { margin: 0; }
  .note { margin-top: 40px; }
  @media (max-width: 899px) { .cs { padding-top: calc(var(--header) + 14vh); } }
</style>
