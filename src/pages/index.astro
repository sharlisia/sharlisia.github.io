---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import SeriesBody from '../components/SeriesBody.astro';
import { getSeries } from '../lib/photos';
import { site } from '../site.config';

const series = await getSeries();
const pad = (n: number) => String(n).padStart(2, '0');
const anchor = (title: string) => title.toLowerCase().replace(/\s+/g, '-');
const albums = series.map((s, i) => ({
  ...s,
  id: anchor(s.title),
  num: pad(i + 1),
  photos: s.groups.flatMap((g) => g.rows.flatMap((r) => r.photos)), // 与页面上的照片顺序一致
}));
const views = [
  { id: 'album', label: 'Album' },
  { id: 'grid', label: 'Grid' },
  { id: 'gallery', label: 'Gallery' },
];
const HERO_SIZES = '(min-width: 900px) calc(100vw - 200px), 100vw';
---

<Base section="photography">
  <nav class="rail" aria-label="Albums">
    <div class="rail-part">
      <p class="muted rail-label">View</p>
      <div class="views" role="group" aria-label="View">
        {views.map((v) => <button type="button" data-view-btn={v.id}>{v.label}</button>)}
      </div>
    </div>
    <div class="rail-part" data-dock>
      <p class="muted rail-label">Albums</p>
      <ol>
        {albums.map((c) => (
          <li>
            <a href={`#${c.id}`} data-rail={c.id} class="ri">
              <span class="thumb" aria-hidden="true">
                <Image src={c.cover.src} alt="" width={240} format="webp" quality={72} loading="lazy" />
              </span>
              <span class="t">{c.title}</span>
              <span class="zh">{c.zh}</span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </nav>

  <!-- 画廊视图：大图 + 底部缩略图条 -->
  <div class="gal" data-gal>
    <div class="gal-stage" data-gal-stage>
      <img alt="" data-gal-img />
    </div>
    <p class="gal-cap muted" data-gal-cap></p>
    <div class="gal-strip">
      {albums.map((c) => (
        <div class="gal-ch">
          {c.photos.map((p) => (
            <button type="button" class="gal-th" aria-label={c.title}>
              <Image src={p.src} alt="" width={200} format="webp" quality={70} loading="lazy" />
            </button>
          ))}
        </div>
      ))}
    </div>
  </div>

  <main id="top">
    <!-- 头图：每个相册的封面轮播 -->
    <section class="hero" data-theme-zone="light" data-hero>
      {albums.map((c, i) => (
        <a href={`#${c.id}`} class:list={['hero-slide', { on: i === 0 }]} data-slide={i} tabindex="-1">
          <Image
            src={c.cover.src}
            alt=""
            widths={[800, 1400, 2000].filter((w) => w <= c.cover.src.width)}
            sizes={HERO_SIZES}
            format="webp"
            quality={80}
            loading={i === 0 ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : 'auto'}
          />
        </a>
      ))}
      <div class="hero-text">
        <h1>{site.album}</h1>
        <p>{site.albumZh}</p>
      </div>
      <div class="hero-index">
        <span class="hero-now" data-hero-now>{albums[0].title} {albums[0].zh}</span>
        <span class="hero-bars">
          {albums.map((c, i) => (
            <button type="button" class:list={['bar', { on: i === 0 }]} data-bar={i} aria-label={c.title}><i></i></button>
          ))}
        </span>
      </div>
    </section>

    {albums.map((c) => (
      <section class="ch" id={c.id} data-theme-zone={c.theme} data-title={c.title} data-zh={c.zh ?? ''}>
        <header class="ch-head">
          <span class="muted">{c.num}</span>
          <h2>{c.title}</h2>
          <span class="muted">{c.zh}</span>
          {c.place && <span class="muted place">{c.place}</span>}
        </header>
        <SeriesBody groups={c.groups} />
      </section>
    ))}

    <footer class="foot muted">
      <span>© {new Date().getFullYear()} {site.name}</span>
      {site.email && <a href={`mailto:${site.email}`}>{site.email}</a>}
    </footer>
  </main>

  <div slot="sheet" class="sheet-photo">
    <div class="sheet-part">
      <p class="muted">Albums</p>
      <ol>
        {albums.map((c) => <li><a href={`#${c.id}`}>{c.title} <span class="muted">{c.zh}</span></a></li>)}
      </ol>
    </div>
    <div class="sheet-views">
      {views.map((v) => <button type="button" data-view-btn={v.id} data-close-sheet>{v.label}</button>)}
    </div>
  </div>

  <!-- 单击放大的弹窗 -->
  <div class="lb" data-lb hidden>
    <img alt="" data-lb-img />
  </div>
</Base>

<script>
  const html = document.documentElement;
  const $ = <T extends Element = HTMLElement>(s: string, el: ParentNode = document) => el.querySelector<T>(s)!;
  const $$ = <T extends Element = HTMLElement>(s: string, el: ParentNode = document) => [...el.querySelectorAll<T>(s)];
  const figures = $$<HTMLElement>('.ch .ph');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const pad2 = (n: number) => String(n).padStart(2, '0');
  const chOf = (i: number) => figures[i].closest<HTMLElement>('.ch')!;
  const centerOn = (el: Element) => {
    const b = el.getBoundingClientRect();
    scrollTo({ top: scrollY + b.top + b.height / 2 - innerHeight / 2, behavior: 'instant' });
  };

  /* ── 当前相册：目录高亮 + 深色相册切换背景 ── */
  let current: HTMLElement | null = null;
  function setCurrent(el: HTMLElement | null, theme?: string) {
    current = el;
    html.dataset.theme = theme ?? el?.dataset.themeZone ?? 'light';
    $$('[data-rail]').forEach((a) => a.classList.toggle('active', !!el && a.dataset.rail === el.id));
  }
  const spy = new IntersectionObserver(
    (es) => {
      if (html.dataset.view === 'gallery') return;
      for (const e of es) {
        if (!e.isIntersecting) continue;
        const el = e.target as HTMLElement;
        setCurrent(el.classList.contains('ch') ? el : null, el.dataset.themeZone);
      }
    },
    { rootMargin: '-50% 0px -50% 0px' },
  );
  $$('[data-theme-zone]').forEach((z) => spy.observe(z));

  /* ── 淡入 ── */
  const revealIO = new IntersectionObserver(
    (es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); revealIO.unobserve(e.target); } }),
    { rootMargin: '0px 0px -6% 0px' },
  );

  /* ── 头图轮播 ── */
  const slides = $$('[data-slide]');
  const bars = $$('[data-bar]');
  const heroNow = $('[data-hero-now]');
  const albumNames = $$<HTMLElement>('.ch').map((c) => `${c.dataset.title} ${c.dataset.zh}`);
  let hi = 0, heroTimer = 0;
  function heroGo(i: number) {
    hi = (i + slides.length) % slides.length;
    slides.forEach((s, k) => s.classList.toggle('on', k === hi));
    bars.forEach((b, k) => { b.classList.remove('on'); if (k === hi) { void b.offsetWidth; b.classList.add('on'); } });
    heroNow.textContent = albumNames[hi];
    const next = slides[(hi + 1) % slides.length].querySelector('img');
    if (next) next.loading = 'eager';
  }
  function heroPlay() { clearInterval(heroTimer); if (!reduce) heroTimer = window.setInterval(() => heroGo(hi + 1), 6000); }
  bars.forEach((b, k) => b.addEventListener('click', () => { heroGo(k); heroPlay(); }));
  heroGo(0); heroPlay();

  /* ── 画廊视图 ── */
  const galImg = $<HTMLImageElement>('[data-gal-img]');
  const galCap = $('[data-gal-cap]');
  const thumbs = $$<HTMLButtonElement>('.gal-th');
  let gi = 0;
  function galSelect(i: number, scrollStrip = true) {
    gi = (i + figures.length) % figures.length;
    const src = figures[gi].querySelector('img')!;
    galImg.classList.remove('on');
    galImg.sizes = '(max-width: 899px) 100vw, 70vw';
    galImg.srcset = src.srcset;
    galImg.src = src.src;
    galImg.decode().then(() => galImg.classList.add('on'), () => galImg.classList.add('on'));
    const ch = chOf(gi);
    const inCh = $$('.ph', ch);
    galCap.textContent = `${ch.dataset.title} ${ch.dataset.zh}  —  ${pad2(inCh.indexOf(figures[gi]) + 1)} / ${pad2(inCh.length)}`;
    thumbs.forEach((t, k) => t.classList.toggle('on', k === gi));
    if (scrollStrip) thumbs[gi].scrollIntoView({ inline: 'center', block: 'nearest', behavior: reduce ? 'instant' : 'smooth' });
    setCurrent(ch);
  }
  thumbs.forEach((t, k) => t.addEventListener('click', () => galSelect(k, false)));
  $('[data-gal-stage]').addEventListener('click', (e) => {
    const b = (e.currentTarget as HTMLElement).getBoundingClientRect();
    galSelect((e as MouseEvent).clientX < b.left + b.width / 2 ? gi - 1 : gi + 1);
  });

  /* ── 视图切换 ── */
  const sizesFor: Record<string, (img: HTMLImageElement) => string> = {
    album: (img) => img.dataset.sizes || '100vw',
    grid: () => '(max-width: 640px) 50vw, 22vw',
    gallery: (img) => img.dataset.sizes || '100vw',
  };
  const visibleFigure = () =>
    figures.find((f) => { const b = f.getBoundingClientRect(); return b.bottom > innerHeight * 0.3 && b.top < innerHeight; });
  function setView(view: string, init = false) {
    if (!(view in sizesFor)) view = 'album';
    const anchorFig = init ? undefined : html.dataset.view === 'gallery' ? figures[gi] : visibleFigure();
    html.dataset.view = view;
    try { localStorage.setItem('view', view); } catch {}
    $$('[data-view-btn]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.viewBtn === view)));
    figures.forEach((f) => {
      const img = f.querySelector('img')!;
      img.sizes = sizesFor[view](img);
      if (!init) f.classList.add('in');
    });
    if (view === 'gallery') {
      galSelect(anchorFig ? figures.indexOf(anchorFig) : current ? figures.indexOf($('.ph', current)) : 0);
      scrollTo({ top: 0, behavior: 'instant' });
    } else if (anchorFig) {
      centerOn(anchorFig);
    }
  }
  $$('[data-view-btn]').forEach((b) => b.addEventListener('click', () => setView(b.dataset.viewBtn!)));
  setView(html.dataset.view || 'album', true);
  $$('.reveal').forEach((el) => revealIO.observe(el));

  // 画廊视图下，点目录 = 跳到该相册第一张
  $$<HTMLAnchorElement>('a[href^="#"]').forEach((a) => a.addEventListener('click', (e) => {
    if (html.dataset.view !== 'gallery') return;
    const ch = document.getElementById(a.getAttribute('href')!.slice(1));
    if (!ch?.classList.contains('ch')) return;
    e.preventDefault();
    galSelect(figures.indexOf($('.ph', ch)));
  }));

  /* ── 目录 Dock 效果：悬停时封面抽出，离鼠标越近放得越大 ── */
  const dock = $('[data-dock]');
  const items = $$('.ri', dock);
  let centers: number[] = [];
  dock.addEventListener('mouseenter', () => {
    centers = items.map((it) => { const b = it.getBoundingClientRect(); return b.top + b.height / 2; });
    dock.classList.add('open');
  });
  dock.addEventListener('mousemove', (e) => {
    if (reduce) return;
    items.forEach((it, i) => {
      const t = Math.max(0, 1 - Math.abs(e.clientY - centers[i]) / 110);
      it.style.setProperty('--s', (1 + 1.6 * t * t * (3 - 2 * t)).toFixed(3)); // smoothstep 衰减
    });
  });
  dock.addEventListener('mouseleave', () => {
    dock.classList.remove('open');
    items.forEach((it) => it.style.removeProperty('--s'));
  });

  /* ── 单击放大：从原位置放大成弹窗，再次单击缩回 ── */
  const lb = $('[data-lb]');
  const lbImg = $<HTMLImageElement>('[data-lb-img]');
  let li = -1;
  function targetRect(r: number) {
    const maxW = innerWidth * (innerWidth < 640 ? 0.94 : 0.86);
    const maxH = innerHeight * 0.86;
    const w = Math.min(maxW, maxH * r), h = w / r;
    return { left: (innerWidth - w) / 2, top: (innerHeight - h) / 2, width: w, height: h };
  }
  function place(i: number) {
    const f = figures[i];
    const src = f.querySelector('img')!;
    const t = targetRect(parseFloat(f.dataset.r || '1'));
    Object.assign(lbImg.style, { left: `${t.left}px`, top: `${t.top}px`, width: `${t.width}px`, height: `${t.height}px` });
    lbImg.removeAttribute('srcset');
    lbImg.src = src.currentSrc || src.src; // 先用已加载的图，立刻显示
    lbImg.sizes = `${Math.round(t.width)}px`;
    lbImg.srcset = src.srcset; // 再换成更清晰的版本
    return t;
  }
  function flipFrom(i: number, t: { left: number; top: number; width: number }) {
    const b = figures[i].getBoundingClientRect();
    const s = b.width / t.width;
    return `translate(${b.left - t.left}px, ${b.top - t.top}px) scale(${s})`;
  }
  function openLb(i: number) {
    li = i;
    const t = place(i);
    lb.hidden = false;
    html.classList.add('lock');
    figures[i].classList.add('lifted');
    if (reduce) { lb.classList.add('on'); return; }
    lbImg.style.transition = 'none';
    lbImg.style.transform = flipFrom(i, t);
    requestAnimationFrame(() => requestAnimationFrame(() => {
      lbImg.style.transition = '';
      lbImg.style.transform = 'none';
      lb.classList.add('on');
    }));
  }
  function closeLb() {
    if (li < 0) return;
    const i = li; li = -1;
    lb.classList.remove('on');
    const done = () => { lb.hidden = true; html.classList.remove('lock'); figures[i].classList.remove('lifted'); lbImg.style.transform = ''; };
    if (reduce) return done();
    const t = lbImg.getBoundingClientRect();
    lbImg.style.transform = flipFrom(i, t);
    setTimeout(done, 420);
  }
  function stepLb(d: number) {
    if (li < 0) return;
    figures[li].classList.remove('lifted');
    li = (li + d + figures.length) % figures.length;
    figures[li].classList.add('lifted');
    centerOn(figures[li]);
    place(li);
  }
  figures.forEach((f, i) => f.addEventListener('click', () => { if (html.dataset.view !== 'gallery') openLb(i); }));
  lb.addEventListener('click', closeLb);
  addEventListener('resize', () => { if (li >= 0) place(li); });

  addEventListener('keydown', (e) => {
    if (li >= 0) {
      if (e.key === 'Escape') closeLb();
      else if (e.key === 'ArrowRight') stepLb(1);
      else if (e.key === 'ArrowLeft') stepLb(-1);
    } else if (html.dataset.view === 'gallery') {
      if (e.key === 'ArrowRight' || e.key === 'ArrowDown') { e.preventDefault(); galSelect(gi + 1); }
      else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') { e.preventDefault(); galSelect(gi - 1); }
    }
  });
</script>

<style>
  .views { display: flex; flex-wrap: wrap; gap: 6px 14px; }
  .views button,
  .sheet-views button { color: var(--muted); transition: color 0.3s; }
  .views button:hover,
  .views button[aria-pressed='true'],
  .sheet-views button[aria-pressed='true'] { color: var(--fg); }

  :global(html:not([data-view='gallery'])) .ch :global(.ph) { cursor: zoom-in; }

  /* ── 左侧目录 ── */
  .rail {
    position: fixed;
    z-index: 30;
    top: calc(var(--header) + 40px);
    left: var(--gutter);
    width: calc(var(--rail) - var(--gutter) - 16px);
  }
  .rail-part + .rail-part { margin-top: 32px; }
  .rail-label { margin: 0 0 10px; font-size: 11px; letter-spacing: 0.04em; }
  .rail ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .ri {
    --s: 1;
    display: flex;
    align-items: center;
    gap: 0;
    min-height: 22px;
    color: var(--muted);
    transition: color 0.4s var(--ease), gap 0.35s var(--ease);
  }
  .ri .t { flex: 1; }
  .ri:hover,
  .ri.active { color: var(--fg); }

  /* 封面：平时收起，悬停目录时抽出，并按 --s 放大 */
  .thumb {
    flex: none;
    width: 0;
    height: 22px;
    overflow: hidden;
    border-radius: 2px;
    opacity: 0;
    transition: width 0.25s var(--ease), height 0.25s var(--ease), opacity 0.3s var(--ease);
  }
  .thumb :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .open .ri { gap: 10px; }
  .open .thumb {
    opacity: 1;
    width: calc(30px * var(--s));
    height: calc(22px * var(--s));
  }
  .open .ri:hover .thumb { box-shadow: 0 6px 18px rgba(0, 0, 0, 0.18); }

  main { padding-left: var(--rail); }

  /* ── 头图 ── */
  .hero {
    position: relative;
    height: calc(100svh - var(--header));
    margin-top: var(--header);
    overflow: hidden;
    background: #111;
    color: #fff;
  }
  .hero-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1.8s var(--ease);
  }
  .hero-slide.on { opacity: 1; z-index: 1; }
  .hero-slide :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.06);
    transition: transform 8s linear;
  }
  .hero-slide.on :global(img) { transform: scale(1); }
  .hero::after {
    content: '';
    position: absolute;
    inset: 50% 0 0 0;
    z-index: 2;
    background: linear-gradient(to bottom, transparent, rgba(0, 0, 0, 0.42));
    pointer-events: none;
  }
  .hero-text,
  .hero-index {
    position: absolute;
    z-index: 3;
    bottom: clamp(20px, 4vh, 40px);
  }
  .hero-text { left: var(--gutter); }
  .hero-text h1 {
    margin: 0 0 6px;
    font-size: clamp(30px, 3.6vw, 52px);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1;
  }
  .hero-text p { margin: 0; opacity: 0.75; }
  .hero-index {
    right: var(--gutter);
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 10px;
  }
  .hero-now { opacity: 0.85; }
  .hero-bars { display: flex; gap: 6px; }
  .bar { width: 22px; height: 12px; display: flex; align-items: center; }
  .bar i {
    display: block;
    width: 100%;
    height: 1px;
    background: rgba(255, 255, 255, 0.35);
    position: relative;
    overflow: hidden;
  }
  .bar i::after {
    content: '';
    position: absolute;
    inset: 0;
    background: #fff;
    transform: scaleX(0);
    transform-origin: left;
  }
  .bar.on i::after { animation: fill 6s linear forwards; }
  @keyframes fill { to { transform: scaleX(1); } }

  /* ── 相册 ── */
  .ch { padding-top: clamp(100px, 20vh, 240px); }
  .ch-head {
    display: flex;
    align-items: baseline;
    gap: 14px;
    margin: 0 var(--gutter) clamp(28px, 5vh, 56px);
    padding-top: 12px;
    border-top: 1px solid var(--line);
    transition: border-color 0.9s var(--ease);
  }
  .ch-head h2 { margin: 0; font-size: 13px; font-weight: 600; }
  .place { margin-left: auto; }

  .foot { display: flex; justify-content: space-between; gap: 16px; padding: 20vh var(--gutter) 28px; }

  /* ── 画廊视图 ── */
  .gal { display: none; }
  :global(html[data-view='gallery']) main { display: none; }
  :global(html[data-view='gallery']) .gal {
    position: fixed;
    inset: var(--header) 0 0 var(--rail);
    display: flex;
    flex-direction: column;
  }
  .gal-stage {
    position: relative;
    flex: 1;
    min-height: 0;
    margin: 2vh var(--gutter) 0;
    cursor: pointer;
  }
  .gal-stage img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    opacity: 0;
    transition: opacity 0.6s var(--ease);
  }
  .gal-stage img.on { opacity: 1; }
  .gal-cap { margin: 14px var(--gutter) 12px; white-space: pre; }
  .gal-strip {
    display: flex;
    gap: 22px;
    overflow-x: auto;
    padding: 0 var(--gutter) 20px;
    scrollbar-width: none;
  }
  .gal-strip::-webkit-scrollbar { display: none; }
  .gal-ch { display: flex; gap: 6px; flex: none; }
  .gal-th {
    flex: none;
    height: 64px;
    opacity: 0.45;
    transition: opacity 0.3s var(--ease), transform 0.3s var(--ease);
  }
  .gal-th :global(img) { height: 100%; width: auto; }
  .gal-th:hover { opacity: 0.85; }
  .gal-th.on { opacity: 1; transform: translateY(-4px); }

  /* ── 放大弹窗 ── */
  .lb {
    position: fixed;
    inset: 0;
    z-index: 80;
    cursor: zoom-out;
  }
  .lb[hidden] { display: none; }
  .lb::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--bg);
    opacity: 0;
    transition: opacity 0.4s var(--ease);
  }
  .lb.on::before { opacity: 0.94; }
  .lb img {
    position: fixed;
    object-fit: cover;
    transform-origin: 0 0;
    transition: transform 0.42s var(--ease);
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.18);
  }
  .ch :global(.ph.lifted) { visibility: hidden; }

  /* ── 手机 ── */
  @media (max-width: 899px) {
    .rail { display: none; }
    .hero { height: 72svh; }
    .hero-now { display: none; }
    .gal-th { height: 52px; }
  }

  .sheet-photo { display: flex; flex-direction: column; flex: 1; }
  .sheet-part > p { margin: 0 0 10px; }
  .sheet-part ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; font-size: 18px; font-weight: 500; }
  .sheet-part ol .muted { font-size: 13px; font-weight: 400; }
  .sheet-views { margin-top: auto; padding-top: 32px; display: flex; gap: 22px; }

  @media (prefers-reduced-motion: reduce) {
    .thumb,
    .hero-slide,
    .hero-slide :global(img),
    .lb img,
    .lb::before { transition: none; }
